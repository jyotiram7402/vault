# Copy this file to .env.local for local development, or paste these names and
# values into Vercel → Project → Settings → Environment Variables.
#
# All of these are NEXT_PUBLIC_*, which means they are baked into the browser
# bundle at build time. Changing one requires a redeploy. That is fine: none of
# them is a secret. Never add a Supabase secret key or service-role key here.

# Your Supabase project URL. Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase publishable key (starts with sb_publishable_).
# Older projects may only have a legacy anon key; in that case leave this blank
# and set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Fallback for projects that only have the legacy anon key (a long JWT).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public address of your deployment. Used for metadata and the Emergency Kit.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Set to true to show "Continue with Google" on the sign-in page.
# Requires the Google provider to be configured in Supabase.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
